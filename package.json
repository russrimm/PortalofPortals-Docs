{
  "name": "portalofportals-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Local, static documentation and screenshot library for Portal 360.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "screenshots:import": "node scripts/import-screenshots.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "npm run build && node --test",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "marked": "17.0.4"
  }
}
